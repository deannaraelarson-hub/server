{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/ws", "dest": "/server.js" },
    { "src": "/admin.html", "dest": "/admin.html" },
    { "src": "/index.html", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/server.js" }
  ]
}
